    "react-i18next": "16.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@carbon/react": "^1.71.0",
    "@openmrs/esm-framework": "next",
    "@openmrs/webpack-config": "next",
    "@types/react": "^18.3.21",
    "openmrs": "next",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.30.6",
    "single-spa-react": "^6.0.2",
    "swr": "2.5.1",
    "typescript": "^5.0.0",
    "webpack": "^5.88.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadiroGlobalHealth/uvl-esm-imaging-gate.git"
