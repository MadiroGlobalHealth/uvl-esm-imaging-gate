{
  "name": "@madiro/esm-imaging-gate-app",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "Refuses imaging results entry until the order's payment is confirmed (UVL-EMR #322)",
  "browser": "dist/madiro-esm-imaging-gate-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
